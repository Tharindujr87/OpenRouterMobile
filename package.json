{
  "name": "ormobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "deploy:web": "npm run build:web && wrangler pages deploy dist --project-name=ormobile",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "~9.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "expo": "~58.0.26",
    "expo-calendar": "~58.0.8",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.14",
    "expo-notifications": "~58.1.9",
    "expo-sharing": "~58.0.23",
    "expo-speech": "~58.0.4",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/node": "~24.10.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.26",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "wrangler": "^4.166.0"
  }
}
