{
  "expo": {
    "name": "ORMobile",
    "slug": "ormobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ormobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ormobile.app"
    },
    "android": {
      "package": "com.ormobile.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ORM uses your photos to attach images to notes and diary entries.",
          "cameraPermission": false
        }
      ]
    ]
  }
}
